# v1.1 | 09-Sep-2026 | Document explicit local LLM and TTS settings for the full WP2 loop.
# v1.0 | 07-Sep-2026 | Document explicit local STT settings; no global retention mode.
# Export these settings in the launching shell; .env is not auto-loaded.
KAKI_STT_MODE=canned
KAKI_WHISPER_URL=http://127.0.0.1:8080
KAKI_STT_TIMEOUT_SECONDS=30
KAKI_LLM_MODE=canned
KAKI_LLM_URL=http://127.0.0.1:8082
KAKI_LLM_TIMEOUT_SECONDS=120
KAKI_TTS_MODE=canned
KAKI_TTS_TIMEOUT_SECONDS=30
# Required only by the explicitly consented owner retention CLI; outside Git.
KAKI_DATA_ROOT=/Users/websvc/kaki-talkie-data
