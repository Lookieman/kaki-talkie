# Store normal text files using LF line endings
* text=auto eol=lf

# Windows command files conventionally use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must never be line-ending normalised
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.wav binary
*.mp3 binary
*.m4a binary
*.webm binary
*.zip binary
*.gz binary